{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/seguranca/layout,_N_T_/seguranca/page,_N_T_/seguranca"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/seguranca/__PAGE__",
    "/seguranca",
    "/_index",
    "/_head"
  ]
}